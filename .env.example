# Copy to .env and enter your local credentials.
GEMINI_API_KEY=
GITHUB_TOKEN=

# Authentication: Google OIDC and GitHub OAuth app credentials (server only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Exact browser origin. HTTPS (after mkcert setup) is recommended for local OAuth.
# Run: node scripts/setup_local_https.mjs && node start.mjs --https
# Or keep the existing HTTP address for ordinary local development.
REPOLENS_BASE_URL=https://127.0.0.1:5173
REPOLENS_ENV=development
# Optional: comma-separated trusted reverse-proxy IPs/CIDRs for OAuth abuse protection.
# Only configure when the API is private behind that proxy and X-Forwarded-For is sanitized.
# REPOLENS_TRUSTED_PROXY_NETWORKS=172.16.0.0/12
# Backend may use a free port without changing the OAuth browser origin.
REPOLENS_BACKEND_PORT=8000
# Use internal for the API worker, external for the independent scheduled worker.
REPOLENS_FRESHNESS_SCHEDULER=internal
# Maximum model calls per PR/diff report; coverage limits are shown in the result.
REPOLENS_DIFF_MAX_BATCHES=8
# Production requires a random secret >=32 characters. Never use an example value.
# Local development generates a private persistent key when this is blank.
REPOLENS_SESSION_SECRET=
# Optional persistent private directory for SQLite accounts and sessions.
# REPOLENS_AUTH_DIR=/var/lib/repolens/auth

# Chat storage defaults to conversations.sqlite3 inside REPOLENS_AUTH_DIR.
# Optional PostgreSQL (install psycopg[binary] first); keep credentials server-only.
# REPOLENS_DATABASE_URL=postgresql+psycopg://user:password@localhost/repolens

# Restart after changing provider/model. Different embedding providers need separate indexes.
REPOLENS_MODEL_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
# RAG index coverage. quick = up to 24 files / 60K effective embedded characters (fastest),
# balanced = 40 / 250K, full = 60 / 600K. More coverage takes longer.
# A different profile produces a new index; existing indexes remain untouched.
REPOLENS_RAG_INDEX_PROFILE=quick
# Answer retrieval window (1–12). Larger values help questions spanning
# multiple files, but add model input tokens; does NOT require re-indexing.
REPOLENS_RAG_TOP_K=8
# Conservative local embedding budgets: match the quotas shown for YOUR Gemini
# project. Estimates use ~2 UTF-8 bytes per token; Gemini may tokenize differently.
# Do not blindly increase these beyond actual provider limits.
REPOLENS_EMBED_RPM=10
REPOLENS_EMBED_TPM=20000
# Decrease to 1.0 for stricter token estimates if Gemini returns repeated 429s.
REPOLENS_EMBED_CHARS_PER_TOKEN=2.0
REPOLENS_EMBED_CACHE_DIR=.repolens_cache
# Restart interrupted index jobs automatically, reusing saved embedding batches.
REPOLENS_INDEX_AUTO_RESUME=true
# Default: .repolens_auth/index_jobs.sqlite3
# REPOLENS_INDEX_JOBS_DB=/absolute/private/path/index_jobs.sqlite3

# Optional shared auth database (users/sessions). Run offline migration before switching.
# REPOLENS_AUTH_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1/repolens
# Migration destination; never pass secrets through command-line arguments.
# REPOLENS_MIGRATION_TARGET_URL=postgresql+psycopg://user:password@127.0.0.1/repolens

# Private local source: restart with Ollama selected; approve exact paths and user IDs.
# Find your user ID in /api/auth/me. Never put credentials in this mapping.
REPOLENS_LOCAL_REPOSITORIES={}
# Example value: {"myproject":{"path":"/absolute/path/to/repository","users":["your-user-id"]}}
ANONYMIZED_TELEMETRY=False

# Phase 11 real HTTPS deployment (deployment/compose.production.yml).
# Use a DNS name pointing at your server; do not enter a scheme/port.
# REPOLENS_DOMAIN=repolens.example.com
# REPOLENS_DB_PASSWORD=replace-with-a-long-random-secret
# REPOLENS_AUTH_DATABASE_URL=postgresql+psycopg://repolens:URL_ENCODED_PASSWORD@database:5432/repolens
# REPOLENS_DATABASE_URL=postgresql+psycopg://repolens:URL_ENCODED_PASSWORD@database:5432/repolens
# Never publish internal ports 8000/5432 in production.
